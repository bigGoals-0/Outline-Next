<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="app-root" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.outline.client.ui.MainController">
    <left>
        <HBox>
            <VBox styleClass="rail" spacing="10">
                <padding><Insets top="18" right="12" bottom="18" left="12"/></padding>
                <Label text="OC" styleClass="logo"/>
                <Label text="Chat" styleClass="rail-caption"/>
                <Button text="Home" onAction="#loadHome" styleClass="nav-button"/>
                <Button text="Friends" onAction="#loadFriends" styleClass="nav-button"/>
                <Button text="Chats" onAction="#loadFriends" styleClass="nav-button"/>
                <Region VBox.vgrow="ALWAYS"/>
                <Button text="Profile" onAction="#showProfile" styleClass="nav-button"/>
                <Button text="Logout" onAction="#logout" styleClass="nav-button"/>
            </VBox>
            <VBox styleClass="center-panel" spacing="14">
                <padding><Insets top="18" right="18" bottom="18" left="18"/></padding>
                <VBox spacing="2" styleClass="mini-profile">
                    <Label fx:id="profileLabel" styleClass="profile-name"/>
                    <HBox spacing="6" alignment="CENTER_LEFT">
                        <TextField fx:id="profileHandle" editable="false" focusTraversable="false" styleClass="copyable-field" HBox.hgrow="ALWAYS"/>
                        <Button text="Copy" onAction="#copyOwnUsername" styleClass="copy-button"/>
                    </HBox>
                </VBox>
                <HBox spacing="8">
                    <TextField fx:id="quickSearch" promptText="Search people or add @username" onAction="#search" HBox.hgrow="ALWAYS" styleClass="input"/>
                    <Button text="Search" onAction="#search" styleClass="secondary-button"/>
                </HBox>
                <HBox spacing="8">
                    <Button fx:id="addFriendButton" text="Add" onAction="#addFriend" styleClass="secondary-button"/>
                    <Button fx:id="acceptButton" text="Accept" onAction="#acceptSelected" styleClass="primary-button"/>
                    <Button fx:id="declineButton" text="Decline" onAction="#declineSelected" styleClass="secondary-button"/>
                </HBox>
                <ListView fx:id="centerList" onMouseClicked="#openSelected" VBox.vgrow="ALWAYS" styleClass="conversation-list"/>
            </VBox>
        </HBox>
    </left>
    <center>
        <BorderPane styleClass="chat-shell">
            <top>
                <VBox styleClass="chat-header" spacing="4">
                    <padding><Insets top="18" right="24" bottom="16" left="24"/></padding>
                    <Label fx:id="chatTitle" text="Outline Chat" styleClass="chat-title"/>
                    <Label fx:id="chatSubtitle" text="Recommendations, activity, requests, and quick search" styleClass="muted"/>
                </VBox>
            </top>
            <center>
                <ScrollPane fitToWidth="true" styleClass="message-scroll">
                    <VBox fx:id="messagesBox" spacing="12" styleClass="message-list">
                        <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>
                    </VBox>
                </ScrollPane>
            </center>
            <bottom>
                <HBox styleClass="composer" spacing="10">
                    <padding><Insets top="14" right="18" bottom="18" left="18"/></padding>
                    <Button text="Upload" onAction="#uploadFile" styleClass="secondary-button"/>
                    <TextArea fx:id="messageInput" promptText="Message selected friend" prefRowCount="2" HBox.hgrow="ALWAYS" styleClass="composer-input"/>
                    <Button fx:id="sendButton" text="Send" onAction="#sendMessage" styleClass="primary-button"/>
                </HBox>
            </bottom>
        </BorderPane>
    </center>
    <right>
        <VBox styleClass="right-panel" spacing="18">
            <padding><Insets top="22" right="18" bottom="18" left="18"/></padding>
            <Label fx:id="toastLabel" text="Username copied" visible="false" managed="false" styleClass="toast"/>
            <Label text="Profile" styleClass="section-title"/>
            <Label fx:id="detailAvatar" text="OC" styleClass="detail-avatar"/>
            <Label fx:id="detailName" text="Outline" styleClass="detail-name"/>
            <HBox spacing="6" alignment="CENTER_LEFT">
                <TextField fx:id="detailHandle" text="@outline" editable="false" focusTraversable="false" styleClass="copyable-field" HBox.hgrow="ALWAYS"/>
                <Button text="Copy" onAction="#copyDetailUsername" styleClass="copy-button"/>
            </HBox>
            <TextArea fx:id="detailBio" text="Select a friend to view details." editable="false" wrapText="true" prefRowCount="3" styleClass="readonly-area"/>
            <VBox spacing="8" styleClass="profile-editor">
                <Label text="Edit your profile" styleClass="section-title"/>
                <TextField fx:id="profileNameField" promptText="Display name" styleClass="input"/>
                <TextArea fx:id="profileBioField" promptText="Bio" prefRowCount="4" wrapText="true" styleClass="composer-input"/>
                <Button text="Save Profile" onAction="#saveProfile" styleClass="primary-button"/>
            </VBox>
            <Label text="Shared Files" styleClass="section-title"/>
            <ListView fx:id="sharedFiles" VBox.vgrow="ALWAYS" styleClass="file-list"/>
        </VBox>
    </right>
</BorderPane>
