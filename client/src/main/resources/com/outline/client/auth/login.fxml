<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="login-root" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.outline.client.auth.LoginController">
    <left>
        <VBox styleClass="login-brand" spacing="18">
            <padding><Insets top="64" right="56" bottom="64" left="64"/></padding>
            <Label text="Outline Next" styleClass="brand-title"/>
            <Label text="A focused desktop space for fast teams, private friendships, and durable conversations." wrapText="true" styleClass="brand-copy"/>
            <Region VBox.vgrow="ALWAYS"/>
            <HBox spacing="12">
                <Label text="Realtime" styleClass="pill"/>
                <Label text="Private" styleClass="pill"/>
                <Label text="Desktop" styleClass="pill"/>
            </HBox>
        </VBox>
    </left>
    <center>
        <VBox alignment="CENTER" styleClass="login-panel">
            <VBox spacing="14" maxWidth="420" styleClass="auth-card">
                <Label text="Welcome back" styleClass="auth-title"/>
                <Label text="Sign in or create a new workspace identity." styleClass="muted"/>
                <TextField fx:id="usernameField" promptText="Username" styleClass="input"/>
                <TextField fx:id="displayNameField" promptText="Display name for registration" styleClass="input"/>
                <PasswordField fx:id="passwordField" promptText="Password" styleClass="input"/>
                <CheckBox fx:id="rememberMe" text="Remember me"/>
                <HBox spacing="12">
                    <Button fx:id="loginButton" text="Login" onAction="#login" defaultButton="true" styleClass="primary-button"/>
                    <Button text="Register" onAction="#register" styleClass="secondary-button"/>
                </HBox>
                <Label fx:id="statusLabel" styleClass="status"/>
            </VBox>
        </VBox>
    </center>
</BorderPane>
